# Copy this file to .env and fill in your own values.

# --- Data center ---
# Zoho accounts are region-specific. Pick the domain suffix that matches
# where your Zoho account was created:
#   .com  -> United States (default)
#   .eu   -> Europe
#   .in   -> India
#   .com.au -> Australia
#   .jp   -> Japan
ZOHO_DC=com

# --- Option A (recommended for a real/deployed app): refresh token flow ---
# Create these at https://api-console.zoho.com/ (see README for the full steps).
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=

# Optional. Only needed if the redirect_uri you used to generate the grant
# code / refresh token wasn't the default - set it to the exact same value
# used during that authorization step (e.g. https://sign.zoho.com).
ZOHO_REDIRECT_URI=

# --- Option B (quick local testing only) ---
# Zoho Sign lets you generate a 60-minute "ad hoc" access token from
# Settings > Developer Settings > API token - development.
# If you set this and leave the refresh token fields above blank,
# the server will just use this token directly until it expires.
ZOHO_ACCESS_TOKEN=

# --- Server ---
PORT=3000

# --- Optional: webhook signature verification ---
# Only needed if you've registered a webhook in Zoho Sign (see README) and
# it provides a signing secret. If set, POST /webhooks/zoho-sign will
# verify incoming payloads against this and reject anything that doesn't
# match, instead of trusting requests blindly.
ZOHO_WEBHOOK_SECRET=
